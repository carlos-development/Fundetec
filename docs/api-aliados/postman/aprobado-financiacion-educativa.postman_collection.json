          }
        ],
        "url": "{{base_url}}/api/v1/financiacion-educativa/solicitudes/{{application_id}}/",
        "description": "Consulta periodica del resultado. Idempotency-Key y Content-Type no son requeridos en GET."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET responde 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "const publicStates = ['RECEIVED', 'ACTION_REQUIRED', 'UNDER_REVIEW', 'APPROVED', 'REJECTED', 'CANCELLED'];",
              "const reasons = ['', 'INCOMPLETE_INFORMATION', 'UNREADABLE_DOCUMENT', 'IDENTITY_MISMATCH', 'GUARDIANSHIP_NOT_VERIFIED', 'ENROLLMENT_NOT_VERIFIED', 'OTHER'];",
              "pm.test('El estado pertenece al catalogo publico', function () { pm.expect(publicStates).to.include(data.status); });",
              "pm.test('decision_reason pertenece al catalogo publico', function () { pm.expect(reasons).to.include(data.decision_reason); });",
              "pm.test('Solo APPROVED puede autorizar el curso', function () { if (data.course_authorized) pm.expect(data.status).to.eql('APPROVED'); });",
              "pm.test('La autorizacion contractual trae condiciones financieras', function () {",
              "  if (data.course_authorized) {",
              "    pm.expect(data.status).to.eql('APPROVED');",
              "    pm.expect(data.authorization_effective_at).to.be.a('string');",
              "    pm.expect(data.financial_terms).to.be.an('object');",
              "    pm.expect(data.financial_terms.currency).to.eql('COP');",
              "    pm.expect(data.financial_terms.requested_amount).to.match(/^\\d+\\.\\d{2}$/);",
              "    pm.expect(data.financial_terms.financed_amount).to.match(/^\\d+\\.\\d{2}$/);",
              "    pm.expect(data.financial_terms.estimated_installment).to.match(/^\\d+\\.\\d{2}$/);",
              "    pm.expect(data.financial_terms.term_months).to.be.a('number');",
              "  }",
              "});",
              "pm.test('No expone secretos de continuacion', function () {",
              "  const forbidden = ['token', 'continuation_url', 'continuation_link', 'invitation_url', 'invitation_link'];",
              "  forbidden.forEach(function (key) { pm.expect(data).not.to.have.property(key); });",
              "});"
            ]
          }
        }
      ],
