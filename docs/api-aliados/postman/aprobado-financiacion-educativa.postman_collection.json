  "item": [
    {
      "name": "1. Crear solicitud educativa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "ApiKey {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"external_reference\": \"{{external_reference}}\",\n  \"first_names\": \"LAURA SOFIA\",\n  \"last_names\": \"MARTINEZ RUIZ\",\n  \"phone\": \"3000000000\",\n  \"email\": \"student@example.test\",\n  \"address\": \"Direccion de demostracion\",\n  \"document_type\": \"CC\",\n  \"document_number\": \"0000000001\",\n  \"birth_date\": \"2002-08-15\",\n  \"enrollment_code\": \"DEMO-MAT-001\",\n  \"academic_period\": \"2026-2\",\n  \"campus\": \"Sede demostracion\",\n  \"schedule\": \"Nocturna\",\n  \"program_name\": \"INGLES BASICO A2\",\n  \"enrollment_date\": null,\n  \"plan_value\": \"2500000.00\",\n  \"term\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/financiacion-educativa/solicitudes/",
        "description": "202 confirma recepcion y persistencia. No confirma aprobacion, entrega del correo, desembolso, pago ni firma."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('POST responde 202', function () { pm.response.to.have.status(202); });",
              "const data = pm.response.json();",
              "const publicStates = ['RECEIVED', 'ACTION_REQUIRED', 'UNDER_REVIEW', 'APPROVED', 'REJECTED', 'CANCELLED'];",
              "pm.test('La respuesta usa un estado publico', function () { pm.expect(publicStates).to.include(data.status); });",
              "const replayed = pm.response.headers.get('Idempotent-Replayed') === 'true';",
              "pm.test('Una creacion nueva no se interpreta como aprobacion', function () {",
              "  if (!replayed) {",
              "    pm.expect(data.status).to.eql('RECEIVED');",
              "    pm.expect(data.course_authorized).to.eql(false);",
              "  }",
              "});",
              "pm.test('Nunca expone el enlace privado', function () {",
              "  const forbidden = ['token', 'continuation_url', 'continuation_link', 'invitation_url', 'invitation_link'];",
              "  forbidden.forEach(function (key) { pm.expect(data).not.to.have.property(key); });",
              "});",
              "pm.test('course_authorized solo puede ser true en APPROVED', function () {",
              "  if (data.course_authorized) pm.expect(data.status).to.eql('APPROVED');",
              "});",
              "if (data.application_id) pm.collectionVariables.set('application_id', data.application_id);",
              "if (data.external_reference) pm.collectionVariables.set('external_reference', data.external_reference);"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "202 - RECEIVED",
