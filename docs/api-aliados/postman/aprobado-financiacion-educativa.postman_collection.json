            "key": "Authorization",
            "value": "ApiKey INVALID_CREDENTIAL_PLACEHOLDER",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/financiacion-educativa/solicitudes/00000000-0000-4000-8000-000000000001/"
      },
      "event": [
