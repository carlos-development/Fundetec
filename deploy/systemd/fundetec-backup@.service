[Unit]
Description=Respaldo cifrado de Fundetec (%i)
After=postgresql.service

[Service]
Type=oneshot
User=fundetec-%i
Group=fundetec-%i
WorkingDirectory=/var/www/fundetec-%i/current
EnvironmentFile=/etc/fundetec/backup-%i.env
Environment=BACKUP_ENVIRONMENT=%i
LoadCredential=pg_service.conf:/etc/fundetec/backup-%i.pg_service.conf
LoadCredential=pgpass:/etc/fundetec/backup-%i.pgpass
LoadCredential=recipient.asc:/etc/fundetec/backup-%i-recipient.asc
StateDirectory=fundetec-backup-%i
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -B deploy/backup/fundetec_backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
