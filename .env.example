# Contrato de configuracion para staging. No agregue secretos reales a este archivo.

# Entorno Django
DEPLOYMENT_ENVIRONMENT=staging
DJANGO_LOAD_DOTENV=false
DEBUG=false
SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-characters
USE_SQLITE=false
DATABASE_URL=postgresql://fundetec_staging:replace-with-database-password@127.0.0.1:5432/fundetec_staging
ALLOWED_HOSTS=staging-api.aprobado.com.co
CSRF_TRUSTED_ORIGINS=https://staging-api.aprobado.com.co
PRIMARY_DOMAIN_HOST=staging-api.aprobado.com.co
BRAND_PUBLIC_BASE_URL=https://staging-api.aprobado.com.co
SITE_DOMAIN=staging-api.aprobado.com.co
SITE_HTTPS=true

# Rutas exclusivas de staging
STATIC_ROOT=/var/www/fundetec-staging/shared/staticfiles
MEDIA_ROOT=/var/www/fundetec-staging/shared/media
FINANCIACION_EDUCATIVA_PRIVATE_ROOT=/var/www/fundetec-staging/shared/private
FINANCIACION_EDUCATIVA_PRIVATE_STORAGE_BACKEND=financiacion_educativa.storage.PrivateFileSystemStorage

# Claves internas independientes; generar valores aleatorios distintos.
FINANCIACION_EDUCATIVA_INVITATION_RECIPIENT_HMAC_KEY=replace-with-generated-invitation-hmac-key
FINANCIACION_EDUCATIVA_MOBILE_CAPTURE_TOKEN_HMAC_KEY=replace-with-generated-mobile-hmac-key

# SMTP saliente con desvio obligatorio a una unica bandeja QA en staging.
EMAIL_BACKEND=aprobado_web.email_backends.SafeRoutingEmailBackend
EMAIL_QA_MODE=true
EMAIL_QA_REDIRECT_TO=qa-recipient@example.invalid
EMAIL_QA_SUBJECT_PREFIX=[STAGING QA]
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=noreply@example.invalid
EMAIL_HOST_PASSWORD=replace-with-provider-secret
DEFAULT_FROM_EMAIL=Aprobado <noreply@example.invalid>
SERVER_EMAIL=noreply@example.invalid
EMAIL_TIMEOUT=10
CONTACT_EMAIL=contact@example.invalid
CREDIT_INTERNAL_NOTIFICATION_EMAILS=qa-recipient@example.invalid
EDUCATION_EMAIL_LOGO_URL=https://staging-api.aprobado.com.co/static/images/logo-dark.png

# Parametros del flujo educativo
FINANCIACION_EDUCATIVA_ACREEDOR_RAZON_SOCIAL=replace-with-legal-creditor-name
# Limites comerciales del simulador publico; el motor financiero sigue usando
# exclusivamente la configuracion educativa activa almacenada en la base.
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_MIN_AMOUNT=100000
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_MAX_AMOUNT=2000000
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_INITIAL_AMOUNT=1000000
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_MIN_TERM_MONTHS=1
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_MAX_TERM_MONTHS=6
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_INITIAL_TERM_MONTHS=6
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_RATE_LIMIT_REQUESTS=30
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_RATE_LIMIT_WINDOW_SECONDS=60
FINANCIACION_EDUCATIVA_PUBLIC_SIMULATOR_TRUSTED_PROXY_IPS=127.0.0.1,::1
FINANCIACION_EDUCATIVA_INVITACION_TTL_HOURS=72
FINANCIACION_EDUCATIVA_INVITATION_REISSUE_LIMIT=5
FINANCIACION_EDUCATIVA_INVITATION_REISSUE_WINDOW_HOURS=24
FINANCIACION_EDUCATIVA_INVITATION_REISSUE_COOLDOWN_SECONDS=300
FINANCIACION_EDUCATIVA_INVITATION_DELIVERY_TIMEOUT_SECONDS=10
FINANCIACION_EDUCATIVA_INVITATION_RECOVERY_STALE_SECONDS=300
FINANCIACION_EDUCATIVA_MOBILE_CAPTURE_TTL_MINUTES=30
FINANCIACION_EDUCATIVA_MOBILE_CAPTURE_COOLDOWN_SECONDS=120
FINANCIACION_EDUCATIVA_MOBILE_CAPTURE_REISSUE_LIMIT=5
FINANCIACION_EDUCATIVA_MOBILE_CAPTURE_REISSUE_WINDOW_HOURS=1
FINANCIACION_EDUCATIVA_MAYORIA_EDAD=18
FINANCIACION_EDUCATIVA_DOCUMENT_MAX_BYTES=10485760
FINANCIACION_EDUCATIVA_DOCUMENT_MAX_COUNT=20
FINANCIACION_EDUCATIVA_DOCUMENT_SCAN_BACKEND=financiacion_educativa.services.escaneo_documentos.ClamAVDocumentScanBackend
FINANCIACION_EDUCATIVA_CLAMAV_UNIX_SOCKET=/run/clamav/clamd.ctl
FINANCIACION_EDUCATIVA_CLAMAV_HOST=
FINANCIACION_EDUCATIVA_CLAMAV_PORT=3310
FINANCIACION_EDUCATIVA_CLAMAV_CONNECT_TIMEOUT_SECONDS=3
FINANCIACION_EDUCATIVA_CLAMAV_READ_TIMEOUT_SECONDS=30
FINANCIACION_EDUCATIVA_SCAN_MAX_ATTEMPTS=3
FINANCIACION_EDUCATIVA_SCAN_STALE_SECONDS=300
FINANCIACION_EDUCATIVA_SCAN_MAX_REOPENINGS=1
FINANCIACION_EDUCATIVA_SCAN_REOPEN_EXTRA_ATTEMPTS=1
# Habilita el recorrido ClamAV -> IA -> contrato -> firma. Mantener en false
# hasta validar ClamAV, OpenAI y ZapSign en el ambiente correspondiente.
FINANCIACION_EDUCATIVA_AUTOMATION_ENABLED=false
FINANCIACION_EDUCATIVA_DOCUMENT_AI_BACKEND=financiacion_educativa.services.validacion_documental_ia.DisabledDocumentAIValidationBackend
FINANCIACION_EDUCATIVA_DOCUMENT_AI_MODEL=
FINANCIACION_EDUCATIVA_DOCUMENT_AI_TIMEOUT_SECONDS=30
FINANCIACION_EDUCATIVA_DOCUMENT_AI_MAX_ATTEMPTS=3
FINANCIACION_EDUCATIVA_DOCUMENT_AI_STALE_SECONDS=300
FINANCIACION_EDUCATIVA_DOCUMENT_AI_MIN_CONFIDENCE=0.90
FINANCIACION_EDUCATIVA_DOCUMENT_AI_MIN_QUALITY=0.80
FINANCIACION_EDUCATIVA_DOCUMENT_AI_MIN_LEGIBILITY=0.80
FINANCIACION_EDUCATIVA_ZAPSIGN_BACKEND=financiacion_educativa.services.firma_zapsign.DisabledEducationalSignatureBackend
FINANCIACION_EDUCATIVA_ZAPSIGN_BASE_URL=https://sandbox.api.zapsign.com.br/api/v1
FINANCIACION_EDUCATIVA_ZAPSIGN_API_TOKEN=
FINANCIACION_EDUCATIVA_ZAPSIGN_WEBHOOK_SECRET=
FINANCIACION_EDUCATIVA_ZAPSIGN_WEBHOOK_HEADER=X-Educational-Signature-Secret
FINANCIACION_EDUCATIVA_ZAPSIGN_TIMEOUT_SECONDS=30
FINANCIACION_EDUCATIVA_ZAPSIGN_MAX_ATTEMPTS=3
FINANCIACION_EDUCATIVA_ZAPSIGN_STALE_SECONDS=300
FINANCIACION_EDUCATIVA_ZAPSIGN_SEND_AUTOMATIC_EMAIL=true
FINANCIACION_EDUCATIVA_ZAPSIGN_AUTH_MODE=assinaturaTela-tokenEmail
FINANCIACION_EDUCATIVA_ZAPSIGN_REQUIRE_SELFIE=true
FINANCIACION_EDUCATIVA_SIGNATURE_RECIPIENT_HMAC_KEY=replace-with-independent-hmac-key

# Cache y seguridad HTTP. No habilitar HSTS para todos los subdominios desde staging.
REDIS_URL=
ALLOW_LOCAL_REDIS_FALLBACK=false
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Integraciones heredadas deshabilitadas en staging hasta autorizacion expresa.
OPENAI_API_KEY=
CONTRACTORS_CONTRACT_AI_ENABLED=false
CONTRACTORS_DATACREDITO_ENABLED=false
MANUAL_PAYMENT_AUTH_KEY=
WHATSAPP_INTERNAL_API_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=sandbox
ZAPSIGN_API_TOKEN=
ZAPSIGN_WEBHOOK_SECRET=
ZAPSIGN_ENVIRONMENT=sandbox
ZAPSIGN_SEND_AUTOMATIC_EMAIL=false
APROBADO_INSTITUTION_API_KEY=
